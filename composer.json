{
  "name": "satheez/laravel-rate-limit-dashboard",
  "description": "A Laravel package that provides real-time visibility, dynamic configuration, and actionable insights for rate-limiting.",
  "keywords": [
    "Satheez",
    "laravel",
    "rate-limit",
    "rate-limit-dashboard",
    "laravel-rate-limit-dashboard"
  ],
  "homepage": "https://github.com/satheez/laravel-rate-limit-dashboard",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Satheez",
      "email": "isatheez@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Sa\\RateLimitDashboard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sa\\RateLimitDashboard\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Sa\\RateLimitDashboard\\RateLimitDashboardServiceProvider"
      ]
    }
  },
  "require-dev": {
    "laravel/pint": "^1.15",
    "larastan/larastan": "^2.9|^3.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "rector/rector": "^1.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "format": "vendor/bin/pint",
    "lint": "vendor/bin/phpstan analyse",
    "refactor": "vendor/bin/rector process"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
